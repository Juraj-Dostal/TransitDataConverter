<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TDCGui.ViewModels"
        xmlns:views="clr-namespace:TDCGui.Views"
        mc:Ignorable="d"
        x:Class="TDCGui.MainWindow"
        x:CompileBindings="False"
        Title="GTFS Editor"
        Width="1300" Height="850">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#EEE" Padding="8" BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Vybrať priečinok GTFS" Command="{Binding SelectFolderCommand}"/>
                <TextBlock Text="{Binding SelectedFolder}" MaxWidth="250" TextWrapping="Wrap"/>
                <Button Content="Načítať dáta" Command="{Binding LoadDataCommand}"/>
                <Button Content="Uložiť zmeny" Command="{Binding SaveDataCommand}"/>
                <TextBlock Text="{Binding StatusMessage}" FontWeight="Bold" Margin="10,0,0,0"/>
                <Separator Width="20"/>
                <Button Content="Vybrať cieľ JDF" Command="{Binding SelectConvertFolderCommand}"/>
                <TextBlock Text="{Binding ConvertFolder}" MaxWidth="250" TextWrapping="Wrap"/>
                <Button Content="Konvertovať do JDF" IsEnabled="False" ToolTip.Tip="Zatiaľ neimplementované"/>
            </StackPanel>
        </Border>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10" Spacing="10">
                <TextBlock Text="Typ dát:" VerticalAlignment="Center" FontWeight="Bold"/>
                <ComboBox ItemsSource="{Binding DataTypeItems}" 
                          SelectedItem="{Binding SelectedDataType}"
                          Width="200">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            
            <!-- Dynamic UserControl based on selection -->
            <ContentControl Content="{Binding CurrentView}"/>
        </DockPanel>
    </DockPanel>
</Window>