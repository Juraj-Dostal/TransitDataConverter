<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TDCGui.ViewModels"
        mc:Ignorable="d"
        x:Class="TDCGui.JdfWindow"
        x:CompileBindings="False"
        Title="JDF Prehliadač a Editor"
        Width="1300" Height="850">
    <Design.DataContext>
        <vm:JdfViewModel />
    </Design.DataContext>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#EEE" Padding="8" BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="JDF priečinok:" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SelectedFolder}" MaxWidth="400" TextWrapping="Wrap" FontWeight="Bold"/>
                <Button Content="Uložiť zmeny" Command="{Binding SaveDataCommand}"/>
                <TextBlock Text="{Binding StatusMessage}" FontWeight="Bold" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10" Spacing="10">
                <TextBlock Text="Typ dát:" VerticalAlignment="Center" FontWeight="Bold"/>
                <ComboBox ItemsSource="{Binding DataTypeItems}" 
                          SelectedItem="{Binding SelectedDataType}"
                          Width="250">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            
            <!-- Dynamic UserControl based on selection -->
            <ContentControl Content="{Binding CurrentView}"/>
        </DockPanel>
    </DockPanel>
</Window>
