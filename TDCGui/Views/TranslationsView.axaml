<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             x:Class="TDCGui.Views.TranslationsView">
    <UserControl.Styles>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </UserControl.Styles>
    
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <controls:DataGrid ItemsSource="{Binding}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="False"
                          GridLinesVisibility="All"
                          HeadersVisibility="All"
                          MinHeight="400">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn Header="table_name" Binding="{Binding TableName}" Width="Auto"/>
                <controls:DataGridTextColumn Header="field_name" Binding="{Binding FieldName}" Width="Auto"/>
                <controls:DataGridTextColumn Header="language" Binding="{Binding Language}" Width="Auto"/>
                <controls:DataGridTextColumn Header="translation" Binding="{Binding TranslationText}" Width="Auto"/>
                <controls:DataGridTextColumn Header="record_id" Binding="{Binding RecordId}" Width="Auto"/>
                <controls:DataGridTextColumn Header="record_sub_id" Binding="{Binding RecordSubId}" Width="Auto"/>
                <controls:DataGridTextColumn Header="field_value" Binding="{Binding FieldValue}" Width="Auto"/>
            </controls:DataGrid.Columns>
        </controls:DataGrid>
    </ScrollViewer>
</UserControl>
