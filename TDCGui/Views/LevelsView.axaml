<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             x:Class="TDCGui.Views.LevelsView">
    <UserControl.Styles>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </UserControl.Styles>
    
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <controls:DataGrid ItemsSource="{Binding}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="False"
                          GridLinesVisibility="All"
                          HeadersVisibility="All"
                          MinHeight="400">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn Header="level_id" Binding="{Binding LevelId}" Width="Auto"/>
                <controls:DataGridTextColumn Header="level_index" Binding="{Binding LevelIndex}" Width="Auto"/>
                <controls:DataGridTextColumn Header="level_name" Binding="{Binding LevelName}" Width="Auto"/>
            </controls:DataGrid.Columns>
        </controls:DataGrid>
    </ScrollViewer>
</UserControl>
