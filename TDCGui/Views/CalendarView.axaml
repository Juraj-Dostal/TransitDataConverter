<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             x:Class="TDCGui.Views.CalendarView">
    <UserControl.Styles>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </UserControl.Styles>
    
    <controls:DataGrid ItemsSource="{Binding}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="False"
                      GridLinesVisibility="All"
                      HeadersVisibility="All"
                      MinHeight="400">
        <controls:DataGrid.Columns>
            <controls:DataGridTextColumn Header="service_id" Binding="{Binding ServiceId}" Width="*"/>
            <controls:DataGridTextColumn Header="monday" Binding="{Binding Monday}" Width="*"/>
            <controls:DataGridTextColumn Header="tuesday" Binding="{Binding Tuesday}" Width="*"/>
            <controls:DataGridTextColumn Header="start_date" Binding="{Binding StartDate}" Width="*"/>
            <controls:DataGridTextColumn Header="end_date" Binding="{Binding EndDate}" Width="*"/>
        </controls:DataGrid.Columns>
    </controls:DataGrid>
</UserControl>