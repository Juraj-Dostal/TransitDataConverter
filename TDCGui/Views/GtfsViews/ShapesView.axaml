<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             x:Class="TDCGui.Views.GtfsViews.ShapesView">
    <UserControl.Styles>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </UserControl.Styles>

    <controls:DataGrid ItemsSource="{Binding}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      GridLinesVisibility="All"
                      HeadersVisibility="All">
        <controls:DataGrid.Columns>
            <controls:DataGridTextColumn Header="shape_id" Binding="{Binding ShapeId}" Width="Auto"/>
            <controls:DataGridTextColumn Header="shape_pt_lat" Binding="{Binding ShapePtLat}" Width="Auto"/>
            <controls:DataGridTextColumn Header="shape_pt_lon" Binding="{Binding ShapePtLon}" Width="Auto"/>
            <controls:DataGridTextColumn Header="shape_pt_sequence" Binding="{Binding ShapePtSequence}" Width="Auto"/>
            <controls:DataGridTextColumn Header="shape_dist_traveled" Binding="{Binding ShapeDistTraveled}" Width="Auto"/>
        </controls:DataGrid.Columns>
    </controls:DataGrid>

</UserControl>
