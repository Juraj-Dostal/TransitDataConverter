<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             x:Class="TDCGui.Views.GtfsViews.StopTimesView">
    <UserControl.Styles>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </UserControl.Styles>

    <controls:DataGrid ItemsSource="{Binding}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      GridLinesVisibility="All"
                      HeadersVisibility="All">
        <controls:DataGrid.Columns>
            <controls:DataGridTextColumn Header="trip_id" Binding="{Binding TripId}" Width="Auto"/>
            <controls:DataGridTextColumn Header="stop_id" Binding="{Binding StopId}" Width="Auto"/>
            <controls:DataGridTextColumn Header="arrival_time" Binding="{Binding ArrivalTime}" Width="Auto"/>
            <controls:DataGridTextColumn Header="departure_time" Binding="{Binding DepartureTime}" Width="Auto"/>
            <controls:DataGridTextColumn Header="stop_sequence" Binding="{Binding StopSequence}" Width="Auto"/>
        </controls:DataGrid.Columns>
    </controls:DataGrid>

</UserControl>