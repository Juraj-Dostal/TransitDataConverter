<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             x:Class="TDCGui.Views.GtfsViews.FareRulesView">
    <UserControl.Styles>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </UserControl.Styles>

    <controls:DataGrid ItemsSource="{Binding}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      GridLinesVisibility="All"
                      HeadersVisibility="All">
        <controls:DataGrid.Columns>
            <controls:DataGridTextColumn Header="fare_id" Binding="{Binding FareId}" Width="Auto"/>
            <controls:DataGridTextColumn Header="route_id" Binding="{Binding RouteId}" Width="Auto"/>
            <controls:DataGridTextColumn Header="origin_id" Binding="{Binding OriginId}" Width="Auto"/>
            <controls:DataGridTextColumn Header="destination_id" Binding="{Binding DestinationId}" Width="Auto"/>
            <controls:DataGridTextColumn Header="contains_id" Binding="{Binding ContainsId}" Width="Auto"/>
        </controls:DataGrid.Columns>
    </controls:DataGrid>

</UserControl>
