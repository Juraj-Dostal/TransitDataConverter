<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             x:Class="TDCGui.Views.GtfsViews.LevelsView">
    <UserControl.Styles>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </UserControl.Styles>

    <controls:DataGrid ItemsSource="{Binding}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      GridLinesVisibility="All"
                      HeadersVisibility="All">
        <controls:DataGrid.Columns>
            <controls:DataGridTextColumn Header="level_id" Binding="{Binding LevelId}" Width="Auto"/>
            <controls:DataGridTextColumn Header="level_index" Binding="{Binding LevelIndex}" Width="Auto"/>
            <controls:DataGridTextColumn Header="level_name" Binding="{Binding LevelName}" Width="Auto"/>
        </controls:DataGrid.Columns>
    </controls:DataGrid>

</UserControl>
