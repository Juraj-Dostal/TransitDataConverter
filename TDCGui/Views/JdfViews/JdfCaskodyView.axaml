<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TDCGui.Views.JdfViews.JdfCaskodyView">
    <UserControl.Styles>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </UserControl.Styles>
    <DataGrid ItemsSource="{Binding}"
              IsReadOnly="False"
              CanUserReorderColumns="True"
              CanUserResizeColumns="True"
              GridLinesVisibility="All"
              BorderThickness="1"
              BorderBrush="Gray">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Číslo linky" Binding="{Binding CisloLinky}" Width="Auto"/>
            <DataGridTextColumn Header="Číslo spoje" Binding="{Binding CisloSpoje}" Width="Auto"/>
            <DataGridTextColumn Header="Číslo" Binding="{Binding Cislo}" Width="Auto"/>
            <DataGridTextColumn Header="Označenie" Binding="{Binding Oznacenie}" Width="Auto"/>
            <DataGridTextColumn Header="Typ" Binding="{Binding Typ}" Width="Auto"/>
            <DataGridTextColumn Header="Dátum od" Binding="{Binding DatumOd}" Width="Auto"/>
            <DataGridTextColumn Header="Dátum do" Binding="{Binding DatumDo}" Width="Auto"/>
            <DataGridTextColumn Header="Poznámka" Binding="{Binding Poznamka}" Width="Auto"/>
            <DataGridTextColumn Header="Rozlíšenie linky" Binding="{Binding RozlisenieLinky}" Width="Auto"/>
            </DataGrid.Columns>
    </DataGrid>

</UserControl>
