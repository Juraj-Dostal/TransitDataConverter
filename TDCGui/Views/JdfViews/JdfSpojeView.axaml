<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TDCGui.Views.JdfViews.JdfSpojeView">
    <UserControl.Styles>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </UserControl.Styles>
    <DataGrid ItemsSource="{Binding}"
              IsReadOnly="False"
              CanUserReorderColumns="True"
              CanUserResizeColumns="True"
              GridLinesVisibility="All"
              BorderThickness="1"
              BorderBrush="Gray">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Číslo linky" Binding="{Binding CisloLinky}" Width="Auto"/>
            <DataGridTextColumn Header="Číslo" Binding="{Binding Cislo}" Width="Auto"/>
            <DataGridTextColumn Header="Pevný kód 1" Binding="{Binding PevnyKod1}" Width="Auto"/>
            <DataGridTextColumn Header="Pevný kód 2" Binding="{Binding PevnyKod2}" Width="Auto"/>
            <DataGridTextColumn Header="Pevný kód 3" Binding="{Binding PevnyKod3}" Width="Auto"/>
            <DataGridTextColumn Header="Pevný kód 4" Binding="{Binding PevnyKod4}" Width="Auto"/>
            <DataGridTextColumn Header="Pevný kód 5" Binding="{Binding PevnyKod5}" Width="Auto"/>
            <DataGridTextColumn Header="Pevný kód 6" Binding="{Binding PevnyKod6}" Width="Auto"/>
            <DataGridTextColumn Header="Pevný kód 7" Binding="{Binding PevnyKod7}" Width="Auto"/>
            <DataGridTextColumn Header="Pevný kód 8" Binding="{Binding PevnyKod8}" Width="Auto"/>
            <DataGridTextColumn Header="Pevný kód 9" Binding="{Binding PevnyKod9}" Width="Auto"/>
            <DataGridTextColumn Header="Pevný kód 10" Binding="{Binding PevnyKod10}" Width="Auto"/>
            <DataGridTextColumn Header="Kód skupiny spoju" Binding="{Binding KodSkupinySpoju}" Width="Auto"/>
            <DataGridTextColumn Header="Rozlíšenie linky" Binding="{Binding RozliseniLinky}" Width="Auto"/>
            </DataGrid.Columns>
    </DataGrid>

</UserControl>
